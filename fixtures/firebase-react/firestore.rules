rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can edit their profile
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }
  }
}
